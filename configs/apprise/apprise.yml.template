# Apprise Configuration for Mother Project -- TEMPLATE
#
# DO NOT point Apprise at this file. It is rendered to apprise.yml (gitignored)
# by render.sh, run as the `apprise-init` container before apprise starts.
#
# WHY: Apprise does NOT expand ${VAR} in YAML config. From this project's start
# until 2026-09-02 the live apprise.yml contained these literal placeholders, so
# every URL logged "Unparseable Telegram URL" and every POST to the container was
# answered 204 while delivering nothing. Nothing broke visibly because every
# caller either uses the apprise python library in-process (sync-webhook), posts
# to api.telegram.org directly (grafana, container_watchdog, agent_bridge), or
# falls back to direct Telegram (daily_report.py) -- so the container was dead
# weight for months without a single symptom.
#
# This file is git-tracked and MUST keep the ${...} placeholders -- never the
# real token.
# https://github.com/caronc/apprise/wiki/config_yaml

version: 1

urls:
  # Telegram - Primary notification channel (sync, webhooks, daily report)
  # Format: tgram://bot_token/chat_id/
  - tgram://${TELEGRAM_BOT_TOKEN}/${TELEGRAM_CHAT_ID}/:
      - tag: telegram, all, sync, error, success

  # Telegram - Upgraderr quality upgrade notifications
  - tgram://${TELEGRAM_BOT_TOKEN}/${UPGRADERR_TELEGRAM_CHAT_ID}/:
      - tag: upgraderr

  # Telegram - Curatorr media curation notifications
  - tgram://${TELEGRAM_BOT_TOKEN}/${CURATORR_TELEGRAM_CHAT_ID}/:
      - tag: curatorr

  # Telegram - Mother Notifications (infra/health). Same group Grafana's
  # `team: infra` rules route to. Used by host-level health scripts.
  - tgram://${TELEGRAM_BOT_TOKEN}/${MOTHER_NOTIFICATIONS_CHAT_ID}/:
      - tag: infra, servers
