{
  "__inputs": [],
  "__requires": [],
  "annotations": {"list": []},
  "description": "Log search across all Mother services via Loki",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Log Volume",
      "type": "logs",
      "targets": [{"datasource": {"type": "loki", "uid": "${loki}"}, "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))", "refId": "A"}]
    },
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 20}}, "overrides": []},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 4},
      "id": 2,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Log Rate by Service",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "loki", "uid": "${loki}"}, "expr": "sum by (service) (rate({service=~\"$service\"}[1m]))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 20}}, "overrides": []},
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 9},
      "id": 3,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Error Rate by Service",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "loki", "uid": "${loki}"}, "expr": "sum by (service) (rate({service=~\"$service\"} |= \"ERROR\" [1m]))", "legendFormat": "{{service}} errors", "refId": "A"}]
    },
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 14},
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Logs — $service (filter: $filter)",
      "type": "logs",
      "targets": [{"datasource": {"type": "loki", "uid": "${loki}"}, "expr": "{service=~\"$service\"} |= \"$filter\"", "refId": "A"}]
    },
    {
      "datasource": {"type": "loki", "uid": "${loki}"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 30},
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "Errors Only — $service",
      "type": "logs",
      "targets": [{"datasource": {"type": "loki", "uid": "${loki}"}, "expr": "{service=~\"$service\"} |= \"ERROR\"", "refId": "A"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["logs", "loki", "mother"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource",
        "label": "Loki"
      },
      {
        "current": {"selected": true, "text": ["upgraderr", "sync-webhook", "curatorr"], "value": ["upgraderr", "sync-webhook", "curatorr"]},
        "datasource": {"type": "loki", "uid": "${loki}"},
        "definition": "label_values(service)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": {"label": "service", "stream": "{}", "type": 1},
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "label": "Service",
        "allValue": ".*"
      },
      {
        "current": {"selected": false, "text": "", "value": ""},
        "hide": 0,
        "name": "filter",
        "options": [{"selected": true, "text": "", "value": ""}],
        "query": "",
        "type": "textbox",
        "label": "Text Filter"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Logs Explorer",
  "uid": "mother-logs",
  "version": 1
}
