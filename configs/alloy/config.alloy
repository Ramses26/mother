// ============================================================================
// Grafana Alloy — Mother host log shipping
// Replaces Promtail (retired 2026-08). Replicates the same Loki label schema:
//   { host, service, job, compose_service, image }
// so existing Grafana dashboards/queries keep working unchanged.
// ============================================================================

// ---- Loki write endpoint (local, same host) --------------------------------
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {}
}

// ---- UniFi syslog receiver ---------------------------------------------------
// DESIGN: each site ships to its OWN local Loki -- Stuttler's UDM (10.0.0.1)
// sends here to Mother; Gomaa's UCG (192.168.1.1) sends to Terminus, NOT here.
// Cross-site correlation is done in Grafana via the federated datasources
// (`loki-terminus` on Mother, `loki-mother` on Terminus), not by pointing both
// gateways at one collector. So an absence of Gomaa traffic on this listener is
// correct and expected -- do not "fix" it by re-adding Gomaa here.
//
// Because each Loki only ever holds one site's syslog, per-site labeling needs
// no source-IP relabeling (relabel_rules isn't valid in this block in v1.19.2
// anyway -- tried 2026-08-29, caused a config load failure). The host label is
// simply hardcoded to the site this collector serves: `stuttler-udm` here,
// `gomaa-udm` on Terminus (that name was Terminus's convention first -- matched
// here deliberately, don't rename one without the other). Keep
// `service = "unifi"` identical on both hosts so a federated {service="unifi"}
// query returns both sites, with `host` telling them apart.
//
// syslog_format MUST be rfc3164 (2026-08-31). Alloy defaults to rfc5424, but
// UniFi/UDM emits legacy BSD-style RFC3164 -- every packet was rejected with
// "expecting a version value in the range 1-999 [col 4]" and ZERO UniFi lines
// ever reached Loki between 2026-08-29 and 2026-08-31. Found on Terminus first,
// identical bug here. Do not remove this line.
loki.source.syslog "unifi" {
  listener {
    address       = "0.0.0.0:51514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = {job = "syslog", service = "unifi", host = "stuttler-udm"}
  }
  forward_to = [loki.write.default.receiver]
}

// ---- Docker container logs (all containers on this host) --------------------
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    target_label = "host"
    replacement  = "mother"
  }
  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker.output
  forward_to       = [loki.write.default.receiver]
  refresh_interval = "5s"
}

// ---- Persistent file logs (survive docker rm) ------------------------------
local.file_match "curatorr" {
  path_targets = [{
    __path__ = "/opt/mother/data/logs/curatorr/*.log*",
    service  = "curatorr",
    job      = "file_log",
    host     = "mother",
  }]
}
loki.source.file "curatorr" {
  targets    = local.file_match.curatorr.targets
  forward_to = [loki.write.default.receiver]
}

local.file_match "sync_webhook" {
  path_targets = [{
    __path__ = "/opt/mother/configs/sync-webhook/logs/*.log*",
    service  = "sync-webhook",
    job      = "file_log",
    host     = "mother",
  }]
}
loki.source.file "sync_webhook" {
  targets    = local.file_match.sync_webhook.targets
  forward_to = [loki.write.default.receiver]
}

local.file_match "upgraderr" {
  path_targets = [{
    __path__ = "/opt/mother/data/logs/upgraderr/*.log*",
    service  = "upgraderr",
    job      = "file_log",
    host     = "mother",
  }]
}
loki.source.file "upgraderr" {
  targets    = local.file_match.upgraderr.targets
  forward_to = [loki.write.default.receiver]
}

// ---- agent bridge (2026-09-01) ---------------------------------------------
// The alert-triggered Claude triage bridge (scripts/agent_bridge.py) logs here.
// Shipping it is not optional: the bridge is the thing that INVESTIGATES silent
// failures, so it failing silently would be the worst version of the exact
// pattern this stack keeps getting caught by (backrest ran for 5 months backing
// up nothing; qBittorrent auth was broken for 2.5 months). Its failure modes --
// expired `claude` OAuth credentials, Telegram send failures, repeated agent
// timeouts -- all produce log lines and no other outward signal.
local.file_match "agent_bridge" {
  path_targets = [{
    __path__ = "/opt/mother/data/logs/agent_bridge.log",
    service  = "agent_bridge",
    job      = "file_log",
    host     = "mother",
  }]
}
loki.source.file "agent_bridge" {
  targets    = local.file_match.agent_bridge.targets
  forward_to = [loki.write.default.receiver]
}
