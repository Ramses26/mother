services:
  # qBittorrent - Download Client
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    network_mode: host
    environment:
      - PUID=1028
      - PGID=100
      - TZ=America/New_York
      - WEBUI_PORT=8080
    volumes:
      - /volume1/docker/qbittorrent:/config
      - /volume1/Downloads:/downloads
    restart: unless-stopped

  # QUI - Modern qBittorrent Web Interface
  # Provides multi-instance management, cross-seeding UI, rule-based automation
  # Access at http://10.0.1.203:7476
  qui:
    image: ghcr.io/autobrr/qui:latest
    container_name: qui
    user: "1028:100"
    volumes:
      - /volume1/docker/qui:/config
    ports:
      - "7476:7476"
    restart: unless-stopped

  # Cross-seed - Automated Cross-Seeding with Hardlink Support
  # Finds matching torrents across trackers and injects with hardlinks
  cross-seed:
    image: ghcr.io/cross-seed/cross-seed:6
    container_name: cross-seed
    user: "1028:100"
    environment:
      - TZ=America/New_York
    volumes:
      # Config directory
      - /volume1/docker/cross-seed:/config
      # Downloads - MUST be same volume as linkDirs for hardlinks to work
      - /volume1/Downloads:/downloads
      # BT_backup for torrent-based matching (more robust than data-based)
      - /volume1/docker/qbittorrent/qBittorrent/BT_backup:/torrents:ro
      # Media libraries for data-based matching (optional, read-only)
      - /volume1/4KMovies:/media/4kmovies:ro
      - /volume1/4KTV:/media/4ktv:ro
    ports:
      - "2468:2468"
    command: daemon
    restart: unless-stopped
    depends_on:
      - qbittorrent

  # qbit_manage - qBittorrent automation/cleanup  
  # CRITICAL: Must run on same system as qBittorrent for hardlink detection to work
  # Running this over NFS (like on terminus) breaks hardlink detection
  qbitmanage:
    image: ghcr.io/stuffanthings/qbit_manage:latest
    container_name: qbitmanage
    environment:
      - PUID=1028
      - PGID=100
      - TZ=America/New_York
      - QBT_CONFIG_DIR=/config
      - QBT_LOGFILE=/config/logs/qbit_manage.log
      - QBT_SCHEDULE=30         # run every 30 minutes
      - QBT_STARTUP_DELAY=60    # wait for qBittorrent to come up
      - QBT_RUN=false           # use internal scheduler
      - QBT_WEB_SERVER=false
      - QBT_SHARE_LIMITS=true
      - QBT_TAG_NOHARDLINKS=true
      - QBT_REM_UNREGISTERED=true
      - QBT_REM_ORPHANED=false  # disabled - requires BT_backup access
      - QBT_TAG_TRACKER_ERROR=true
      - QBITMANAGE_QBT_HOST=http://localhost:8080
      - QBITMANAGE_QBT_USER=muthur
      - QBITMANAGE_QBT_PASS=Md4DQbghf@5ptf&K
    volumes:
      - /volume1/docker/qbitmanage:/config
      - /volume1/Downloads:/downloads
      # Optional: BT_backup for orphaned torrent detection
      # - /volume1/docker/qbittorrent/qBittorrent/BT_backup:/bt_backup:ro
    restart: unless-stopped
    depends_on:
      - qbittorrent
