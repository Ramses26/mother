# Env file for the qbittorrentstack compose project on the download Synology
# (10.0.1.203, project name "mother-dlstack"). COPY TO .env ON THAT HOST AND
# FILL IN REAL VALUES. DO NOT COMMIT .env TO GIT.
#
# The Notifiarr API key used by qbitmanage/config.yml's `notifiarr.apikey` is
# a separate secret, set directly in the deployed config.yml on the host, not
# here -- see the redacted placeholder in qbitmanage/config.yml.

QBITMANAGE_QBT_USER=
QBITMANAGE_QBT_PASS=
HAWSER_TOKEN=
