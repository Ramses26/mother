// ============================================================================
// Grafana Alloy — Nostromo (10.0.0.250, Chris's native Plex server) log shipping
// Native install (no Docker on this host). Ships Plex Media Server logs to
// Mother's Loki over the LAN. host = "nostromo".
// ============================================================================

loki.write "default" {
  endpoint {
    url = "http://10.0.0.162:3100/loki/api/v1/push"
  }
}

local.file_match "plex" {
  path_targets = [{
    __path__ = "/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Logs/Plex Media Server.log*",
    service  = "plex",
    job      = "file_log",
    host     = "nostromo",
  }]
}

loki.source.file "plex" {
  targets    = local.file_match.plex.targets
  forward_to = [loki.write.default.receiver]
}

// ----------------------------------------------------------------------------
// Plex backup script log (/home/stutch/plexbackup.sh writes here on every run).
//
// This is the alerting path for the backup, deliberately in place of a
// notification credential: Mother's and Terminus's Apprise instances are both
// non-functional (their YAML uses ${VAR} placeholders, which Apprise does not
// expand), and putting a Telegram bot token on this host is not warranted when
// the log already ships here. Grafana rules `plex_backup_failed` and
// `plex_backup_stale` watch {service="plexbackup"}.
// ----------------------------------------------------------------------------
local.file_match "plexbackup" {
  path_targets = [{
    __path__ = "/var/log/plexbackup.log",
    service  = "plexbackup",
    job      = "file_log",
    host     = "nostromo",
  }]
}

loki.source.file "plexbackup" {
  targets    = local.file_match.plexbackup.targets
  forward_to = [loki.write.default.receiver]
}

// ----------------------------------------------------------------------------
// One-shot Plex maintenance script (/home/stutch/plex-eae-refresh.sh, cron 04:00).
// Ships its log so the outcome is visible without SSHing in -- it may DEFER for
// several nights in a row if someone is streaming at 04:00, and that silence
// would otherwise be indistinguishable from it having run.
// ----------------------------------------------------------------------------
local.file_match "plexmaint" {
  path_targets = [{
    __path__ = "/var/log/plex-maintenance.log",
    service  = "plex-maintenance",
    job      = "file_log",
    host     = "nostromo",
  }]
}

loki.source.file "plexmaint" {
  targets    = local.file_match.plexmaint.targets
  forward_to = [loki.write.default.receiver]
}
