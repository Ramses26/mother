# Mother Project .gitignore

# Environment variables and secrets
.env
*.env
!.env.example

# Local config files with credentials
configs/*/config.xml
configs/*/settings.json
configs/*/*.db
configs/*/*.db-shm
configs/*/*.db-wal

# Ignore all configs EXCEPT recyclarr, qbitmanage, observability stack, decluttarr, and shared scoring
configs/*
!configs/recyclarr/
!configs/qbitmanage/
!configs/loki/
!configs/alloy/
!configs/promtail/
!configs/prometheus/
!configs/grafana/
!configs/scoring/
!configs/decluttarr/

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

# Node
node_modules/
npm-debug.log

# Backup files
*.bak
*.backup
*~

# SSL certificates
*.pem
*.key
*.crt
*.csr

# Database dumps
*.sql
*.dump

# Credentials
credentials/
*.credentials

# Personal notes
NOTES.md
TODO_PERSONAL.md

# Generated inventories and sync reports (large, auto-generated)
inventories/*.json
inventories/*.csv
reports/*.sh
reports/*.log
reports/*.txt
reports/dedup/
reports/plex_dupes/

# Upgraderr runtime data
data/upgraderr/
# Stray/orphaned path -- not the compose-mounted one (data/upgraderr/ above);
# found empty and unreferenced by any current config, 2026-07-24.
data/curatorr/upgraderr_ro/

# Recyclarr managed cache (TRaSH guide data, auto-downloaded)
configs/recyclarr/resources/
configs/recyclarr/state/

# Sync plan CSVs (auto-generated)
reports/*.csv
data/curatorr/curatorr.db
data/upgraderr*.db

# Runtime data / backups / generated reports (large, not source)
data/backrest/
data/curatorr/backups/
data/grafana/
data/loki/
data/prometheus/
data/sync_jobs.db
reports/archive/
reports/*.html
archive/pre-deployment-backups/

# Live-updating stats file, not source
traffic_stats/snapshots.csv

# Claude Code local/personal settings — never shared, machine-specific
.claude/settings.local.json
.claude/*.lock

# Alloy runtime state (positions, WAL)
data/alloy/

# Container watchdog runtime state
data/watchdog/
data/node-exporter-textfile/

# Host-state snapshot for disaster recovery (scripts/snapshot_host_state.sh).
# Contains PRIVATE SSH KEYS and CIFS credentials — captured deliberately so a
# Mother rebuild is possible, protected by restic encryption in the backup.
# It must NEVER reach the git remote.
data/host-state/

# Agent bridge runtime state + maintenance sentinel
data/agent-bridge/
PAUSE_AGENT_BRIDGE

